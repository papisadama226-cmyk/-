<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NORDIC | Boutique Officielle</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header class="navbar">
        <div class="logo">NØRD!C</div>
        <div class="cart-icon-container" onclick="toggleCart()">
            <span>🛒 Panier</span>
            <span id="cartCount" class="cart-count">0</span>
        </div>
    </header>

    <section class="shop-hero">
        <h1>COLLECTION STREETWEAR</h1>
        <p>Prix unique par article : <strong>10 000 FCFA</strong></p>
    </section>

    <main class="products-grid">
        
        <div class="product-card">
            <div class="product-tag">10 000k</div>
            <div class="product-img-placeholder">🌸 DESIGN FLOWER TRIPLE</div>
            <h3>T-Shirt Flower CMYK</h3>
            <p>Fleurs Cyan, Jaune, Magenta - Coupe Oversize</p>
            <button class="add-to-cart-btn" onclick="addToCart('T-Shirt Flower CMYK')">Ajouter au Panier</button>
        </div>

        <div class="product-card">
            <div class="product-tag">10 000k</div>
            <div class="product-img-placeholder">⭐ NORDIC STAR SCRIPT</div>
            <h3>T-Shirt Nordic Star</h3>
            <p>Édition Étoile Bleue & Logo Cursive</p>
            <button class="add-to-cart-btn" onclick="addToCart('T-Shirt Nordic Star')">Ajouter au Panier</button>
        </div>

        <div class="product-card">
            <div class="product-tag">10 000k</div>
            <div class="product-img-placeholder">💵 ALL IN GOD'S PLAN</div>
            <h3>T-Shirt God's Plan</h3>
            <p>Motifs Texture Dollars - Design Urbain</p>
            <button class="add-to-cart-btn" onclick="addToCart('T-Shirt God\'s Plan')">Ajouter au Panier</button>
        </div>

        <div class="product-card">
            <div class="product-tag">10 000k</div>
            <div class="product-img-placeholder">👤 MOTION BLUR PROFILE</div>
            <h3>T-Shirt Motion Face</h3>
            <p>Effet flouté avant-garde Noir & Blanc</p>
            <button class="add-to-cart-btn" onclick="addToCart('T-Shirt Motion Face')">Ajouter au Panier</button>
        </div>

        <div class="product-card">
            <div class="product-tag">10 000k</div>
            <div class="product-img-placeholder">🅰️ NORDIC VARSITY BLOCK</div>
            <h3>T-Shirt Varsity Block</h3>
            <p>Imprimé Universitaire Imposant</p>
            <button class="add-to-cart-btn" onclick="addToCart('T-Shirt Varsity Block')">Ajouter au Panier</button>
        </div>

        <div class="product-card">
            <div class="product-tag">10 000k</div>
            <div class="product-img-placeholder">🩸 KING JESUS SPRAY</div>
            <h3>T-Shirt King Jesus</h3>
            <p>All We Need Is King Jesus - Portrait Rouge</p>
            <button class="add-to-cart-btn" onclick="addToCart('T-Shirt King Jesus')">Ajouter au Panier</button>
        </div>

    </main>

    <div id="cartSidebar" class="cart-sidebar">
        <div class="cart-header">
            <h2>Votre Panier</h2>
            <button class="close-btn" onclick="toggleCart()">✕</button>
        </div>
        <div id="cartItems" class="cart-items-container">
            <p class="empty-msg">Votre panier est vide.</p>
        </div>
        <div class="cart-footer">
            <div class="total-box">
                <span>Total:</span>
                <span id="cartTotal">0 FCFA</span>
            </div>
            
            <div class="form-group-pay">
                <label for="payMethod">Mode de paiement 🇨🇮 :</label>
                <select id="payMethod">
                    <option value="Wave 🌊">Wave 🌊</option>
                    <option value="Orange Money 🍊">Orange Money 🍊</option>
                </select>
            </div>

            <div class="form-group-pay">
                <label for="deliveryLocation">Lieu de livraison / Commune :</label>
                <input type="text" id="deliveryLocation" placeholder="Ex: Angré Terminus 81" required>
            </div>

            <button class="checkout-btn" onclick="validateCheckout()">Passer la commande via WhatsApp</button>
        </div>
    </div>

    <script src="shop.js"></script>
</body>
</html>
