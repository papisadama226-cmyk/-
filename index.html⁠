<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NORDIC | Accès Privé</title>
    <link rel="stylesheet" href="style.css">
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#050505">
</head>
<body>
    <div class="auth-container">
        <div class="brand-badge">NORDIC</div>
        <h1>DEMANDE D'ACCÈS PRIVÉ</h1>
        <p class="subtitle">Collection Streetwear 100% Ivoirienne</p>
        
        <form id="authForm">
            <div class="form-group">
                <label for="clientName">Nom complet</label>
                <input type="text" id="clientName" placeholder="Ex: NANGUI ARLETTE" required>
            </div>
            
            <div class="form-group">
                <label for="clientPhone">Numéro de téléphone</label>
                <input type="tel" id="clientPhone" placeholder="Ex: 0702797128" required>
            </div>
            
            <div class="form-group">
                <label for="accessCode">Code d'accès secret (Si vous en avez un)</label>
                <input type="password" id="accessCode" placeholder="Code optionnel">
            </div>
            
            <button type="submit" class="neon-btn">Demander l'accès au catalogue</button>
        </form>
        
        <div class="admin-notice">
            <p>Une fois soumis, vous serez mis en relation avec l'administration pour valider votre entrée.</p>
        </div>
    </div>

    <script src="auth.js"></script>
    <script>
        // Enregistrement du service worker pour éviter les crashs PWA
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('sw.js').catch(err => console.log(err));
        }
    </script>
</body>
</html>
